# =====================================================================================
# Local development with Docker Compose. Copy to `.env` and replace every placeholder.
# Production values are set in the hosting dashboards (see docs/DEPLOYMENT.md) — never commit them.
# =====================================================================================
COMPOSE_PROJECT_NAME=realestate_crm

# ---- PostgreSQL (the compose `db` container) ----
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_TIME_ZONE=UTC
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
DEFAULT_COMMISSION_RATE=2.5
MAX_UPLOAD_MB=10

# Only for a plain-HTTP local run of the production image (DJANGO_DEBUG=false). Never in real production.
# DJANGO_SECURE_SSL_REDIRECT=false

# Demo data: seeded on startup only when true AND DJANGO_DEBUG=true.
SEED_DEMO_DATA=true
DEMO_PASSWORD=change-me-demo-password

# Optional first admin created on startup when both are set
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# ---- Frontend (Docker) ----
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Where the Next.js dev server proxies /api and /media (container-to-container address)
BACKEND_INTERNAL_URL=http://backend:8000

# ---- Optional: use an external PostgreSQL (e.g. Neon) instead of the compose db ----
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---- Optional: S3-compatible object storage for uploads (required in production) ----
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
