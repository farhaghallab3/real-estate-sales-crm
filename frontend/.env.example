# Public base URL of the Django API, WITHOUT the /api suffix. Set this in Vercel (Project → Settings →
# Environment Variables). Leave it unset for local development: Next.js then proxies /api to Django.
NEXT_PUBLIC_API_URL=https://api.example.com

# Local development only (used when NEXT_PUBLIC_API_URL is unset).
# BACKEND_INTERNAL_URL=http://localhost:8000
